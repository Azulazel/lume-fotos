[Unit]
Description=Lume photo API
After=network-online.target
[Service]
User=lume
Group=lume
WorkingDirectory=/opt/lume/backend
EnvironmentFile=/etc/lume.env
ExecStart=/opt/lume/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lume
UMask=0077
[Install]
WantedBy=multi-user.target
